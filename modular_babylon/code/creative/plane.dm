// Creative Plane (spec 5.2): the catalog maps creative_plane_s/m/l, generated by
// tools/babylon/gen_creative_plane.py into _maps/babylon/. Station build only.
//
// The floor and its indestructible wall ring are one area, the atmos room with its SMES a
// second ("Utilities", its own APC). Both are station areas, so tg's station lists
// (GLOB.the_station_areas, station-level checks) are not empty. They are fullbright (builders
// need no lights), have standard gravity without a gravity generator, and their APCs are fed
// by the creative SMES. The mapped creative canisters connect themselves to their ports
// (machines.dm, babylon_reconnect_port).
//
// The map has no shuttle docks, so its round never ends by shuttle: on any map without the
// "emergency_home" dock, calling the emergency shuttle is refused here, by a player, the
// crew-death autocall or anything else that requests it. The supply shuttle cannot be called
// to a missing "cargo_home" either, and no shuttle accepts a request to a missing dock.

/area/station/babylon
	name = "Babylon"
	icon = 'icons/area/areas_station.dmi'
	icon_state = "station"

/area/station/babylon/creative_plane
	name = "Creative Plane"
	icon_state = "hallCF"
	static_lighting = FALSE
	base_lighting_alpha = 255
	default_gravity = STANDARD_GRAVITY
	requires_power = TRUE
	sound_environment = SOUND_AREA_LARGE_ENCLOSED

/area/station/babylon/creative_plane/utilities
	name = "Creative Plane Utilities"
	icon_state = "engine_smes"
	sound_environment = SOUND_AREA_SMALL_ENCLOSED

/// No stationary dock with this id exists (the Creative Plane has none of the station's).
/proc/babylon_dock_missing(dock_id)
	for(var/obj/docking_port/stationary/port as anything in SSshuttle.stationary_docking_ports)
		if(port.shuttle_id == dock_id)
			return FALSE
	return TRUE

/// This map has no station dock for the emergency shuttle (the Creative Plane).
/proc/babylon_emergency_dock_missing()
	return babylon_dock_missing("emergency_home")

#define BABYLON_NO_EMERGENCY_DOCK_TEXT "This world has no emergency shuttle dock: its round does not end by shuttle."

/datum/controller/subsystem/shuttle/canEvac()
	if(babylon_emergency_dock_missing())
		return BABYLON_NO_EMERGENCY_DOCK_TEXT
	return ..()

/// No crew-death autocall (and its announcement) for a shuttle that could never arrive.
/datum/controller/subsystem/shuttle/CheckAutoEvac()
	if(babylon_emergency_dock_missing())
		return
	return ..()

/// Any other request (admin, autotransfer, events) is refused too, instead of a shuttle that
/// waits forever for a dock.
/obj/docking_port/mobile/emergency/request(obj/docking_port/stationary/S, area/signal_origin, reason, red_alert, set_coefficient = null)
	if(babylon_emergency_dock_missing())
		log_shuttle("Babylon: refused an emergency shuttle call: this map has no emergency shuttle dock.")
		return
	return ..()

#define BABYLON_NO_SUPPLY_DOCK_TEXT "The supply shuttle has no dock at this station."

/// The supply shuttle cannot come to a station without its dock: the console says so instead
/// of announcing an arrival that never happens.
/obj/machinery/computer/cargo/ui_act(action, list/params, datum/tgui/ui, datum/ui_state/state)
	if((action == "send" || action == "loan") && babylon_dock_missing(docking_home) && SSshuttle.supply?.getDockedId() != docking_home)
		say(BABYLON_NO_SUPPLY_DOCK_TEXT)
		return TRUE
	return ..()

/// A request to a dock that does not exist (a station dock missing from this map) is refused
/// quietly instead of reaching canDock(null) and paging the admins.
/obj/docking_port/mobile/request(obj/docking_port/stationary/destination_port)
	if(!destination_port)
		log_shuttle("Babylon: refused to send [src] ([shuttle_id]) to a dock this map does not have.")
		return
	return ..()
