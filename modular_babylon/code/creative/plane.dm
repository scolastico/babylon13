// Creative Plane (spec 5.2): the catalog maps creative_plane_s/m/l, generated by
// tools/babylon/gen_creative_plane.py into _maps/babylon/. Station build only.
//
// The whole floor, its wall ring and the atmos room are one area. It is a station area, so
// tg's station lists (GLOB.the_station_areas, station-level checks) are not empty. It is
// fullbright (builders need no lights), has standard gravity without a gravity generator and
// is powered by the single APC on the south wall, fed by the creative SMES.
//
// The map has no emergency shuttle dock, so its round never ends by shuttle: on any map
// without the "emergency_home" dock, calling the emergency shuttle is refused here, by a
// player, the crew-death autocall or anything else that requests it.

/area/station/babylon
	name = "Babylon"
	icon = 'icons/area/areas_station.dmi'
	icon_state = "station"

/area/station/babylon/creative_plane
	name = "Creative Plane"
	icon_state = "hallCF"
	static_lighting = FALSE
	base_lighting_alpha = 255
	default_gravity = STANDARD_GRAVITY
	requires_power = TRUE
	sound_environment = SOUND_AREA_LARGE_ENCLOSED

/// Connects the canister on its tile to the connector port there once the pipe networks exist
/// (SSair builds them after mapload), as a wrench would. tg leaves mapped canisters unconnected.
/obj/effect/mapping_helpers/babylon_canister_connect
	name = "canister port connector"

/obj/effect/mapping_helpers/babylon_canister_connect/Initialize(mapload)
	..()
	if(SSair.initialized)
		connect_canister()
		return INITIALIZE_HINT_QDEL
	RegisterSignal(SSair, COMSIG_SUBSYSTEM_POST_INITIALIZE, PROC_REF(on_air_initialized))
	return INITIALIZE_HINT_NORMAL

/obj/effect/mapping_helpers/babylon_canister_connect/Destroy()
	UnregisterSignal(SSair, COMSIG_SUBSYSTEM_POST_INITIALIZE)
	return ..()

/obj/effect/mapping_helpers/babylon_canister_connect/proc/on_air_initialized(datum/source)
	SIGNAL_HANDLER
	connect_canister()
	qdel(src)

/obj/effect/mapping_helpers/babylon_canister_connect/proc/connect_canister()
	var/obj/machinery/atmospherics/components/unary/portables_connector/port = locate() in loc
	var/obj/machinery/portable_atmospherics/canister/canister = locate() in loc
	if(!port || !canister || !canister.connect(port))
		log_mapping("[src] at [AREACOORD(src)] found no canister and free connector port to connect.")

/// This map has no station dock for the emergency shuttle (the Creative Plane).
/proc/babylon_emergency_dock_missing()
	for(var/obj/docking_port/stationary/port as anything in SSshuttle.stationary_docking_ports)
		if(port.shuttle_id == "emergency_home")
			return FALSE
	return TRUE

#define BABYLON_NO_EMERGENCY_DOCK_TEXT "This world has no emergency shuttle dock: its round does not end by shuttle."

/datum/controller/subsystem/shuttle/canEvac()
	if(babylon_emergency_dock_missing())
		return BABYLON_NO_EMERGENCY_DOCK_TEXT
	return ..()

/// No crew-death autocall (and its announcement) for a shuttle that could never arrive.
/datum/controller/subsystem/shuttle/CheckAutoEvac()
	if(babylon_emergency_dock_missing())
		return
	return ..()

/// Any other request (admin, autotransfer, events) is refused too, instead of a shuttle that
/// waits forever for a dock.
/obj/docking_port/mobile/emergency/request(obj/docking_port/stationary/S, area/signal_origin, reason, red_alert, set_coefficient = null)
	if(babylon_emergency_dock_missing())
		log_shuttle("Babylon: refused an emergency shuttle call: this map has no emergency shuttle dock.")
		return
	return ..()
